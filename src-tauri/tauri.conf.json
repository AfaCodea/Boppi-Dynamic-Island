{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boppi",
  "version": "0.1.0",
  "identifier": "com.boppi.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Boppi",
        "width": 366,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "focus": false,
        "center": false,
        "x": null,
        "y": 0,
        "acceptFirstMouse": true
      },
      {
        "label": "corner-lyrics",
        "title": "Boppi Lyrics",
        "width": 720,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "focus": false,
        "center": false,
        "x": null,
        "y": 0,
        "acceptFirstMouse": true
      },
      {
        "label": "pomodoro-hud",
        "title": "Boppi Focus HUD",
        "width": 380,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "focus": true,
        "center": true,
        "x": null,
        "y": null,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "infoPlist": "Info.plist"
    }
  }
}
