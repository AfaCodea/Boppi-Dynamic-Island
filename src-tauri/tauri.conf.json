{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boppi",
  "version": "0.1.0",
  "identifier": "com.boppi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Boppi",
        "width": 460,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "focus": false,
        "center": false,
        "x": null,
        "y": 0
      },
      {
        "label": "corner-lyrics",
        "title": "Boppi Lyrics",
        "width": 700,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "focus": false,
        "center": false,
        "x": null,
        "y": 0
      },
      {
        "label": "pomodoro-hud",
        "title": "Boppi Focus HUD",
        "width": 380,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "focus": false,
        "center": true,
        "x": null,
        "y": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
